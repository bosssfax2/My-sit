$botToken =tok();
$chatId =chat();

function sendtg($botToken, $chatId, $msg, $additionalParams = []) {
    $website = "https://api.telegram.org/bot" . $botToken;
    $params = [
        'chat_id' => $chatId,
        'text' => $msg,
        'parse_mode' => 'HTML',
    ];

    // Merge additional parameters if provided
    if (!empty($additionalParams) && is_array($additionalParams)) {
        $params = array_merge($params, $additionalParams);
    }

    $ch = curl_init($website . '/sendMessage');
    curl_setopt($ch, CURLOPT_HEADER, false);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
    curl_setopt($ch, CURLOPT_POST, 1);
    curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($params)); // Added http_build_query
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_setopt($ch, CURLOPT_TIMEOUT, 30); // Added timeout
    curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 10); // Added connection timeout
    
    $result = curl_exec($ch);
    
    // Error handling
    if (curl_errno($ch)) {
        $error = curl_error($ch);
        curl_close($ch);
        return ['error' => $error];
    }
    
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    // Return decoded JSON response
    $response = json_decode($result, true);
    
    // Add HTTP status to response for debugging
    if (is_array($response)) {
        $response['http_code'] = $httpCode;
    }
    
    return $response;
}

function eml() {
    $config = getConfig();
