	function visitors() {
        //$useragent       = $_SERVER['HTTP_USER_AGENT'];
        $ip              = $_SERVER['REMOTE_ADDR'] ?? 'unknown_ip';
        $date            = date("Y-m-d H:i:s", time());
        $os_name         = getOs();
        $browser_name    = getBrowser();
        $country         = clientData('country');

        $hits = '<tr><td width="80"><p>'.$ip.'</th><td width="80"><p>'.$browser_name.'</th><td width="80"><p>'.$os_name.'</th><td width="80"><p >'.$country.'</th><td width="80"><p>'.$date.'</th></th></tr>';
        file_put_contents('data/'.getsitename().'.html', $hits  , FILE_APPEND | LOCK_EX);
    }
	


function setVisitToken() {
    $ip = $_SERVER['REMOTE_ADDR'] ?? 'unknown_ip';
    $userAgent = $_SERVER['HTTP_USER_AGENT'] ?? 'unknown_agent';
    $token = base64_encode($userAgent . $ip . time());
    $_SESSION['whitelist'] = $token;
    return $token;
}


function validateVisit() {
    if(!isset($_SESSION['whitelist'])) {
        header("Location: ../index.php");
        exit();
    }
    return true;
}



function oat() {
    $filePath = 'data/oat.txt';
    
    if (!is_dir('data')) {
        mkdir('data', 0755, true);
    }
    
    $clientIP = $_SERVER['REMOTE_ADDR']; 
    
    if (!file_exists($filePath)) {
        file_put_contents($filePath, ''); 
    }
    
    $ips = file($filePath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);

	if (is_array($ips) && in_array($clientIP, $ips)) {
        header("Location: " . sitexite()); 
        exit; 
    }

    if (!empty($clientIP)) {
        file_put_contents($filePath, $clientIP . PHP_EOL, FILE_APPEND | LOCK_EX);
    }
    return false; 
}


function getVisitorsFromHtml() {
    $htmlFile = DATA_DIR . getSiteName() . '.html';
    
    if (!file_exists($htmlFile) || filesize($htmlFile) === 0) {
        return [];
    }
    
    $content = file_get_contents($htmlFile);
    $visitors = [];
    
    if (strpos($content, '<table>') === false) {
        $content = '<table>' . $content . '</table>';
    }
    
 
    $rowPatterns = [
        '/<tr>(.*?)<\/tr>/si',                
        '/<tr[^>]*>(.*?)<\/tr>/si',             
        '/<tr>[\s\n\r]*(.*?)[\s\n\r]*<\/tr>/si' 
    ];
    
    $rows = [];
    foreach ($rowPatterns as $pattern) {
        preg_match_all($pattern, $content, $matches);
        if (!empty($matches[1])) {
            $rows = $matches[1];
            break;
        }
    }
    
    if (empty($rows)) {
        $rows = explode('<tr>', $content);
        array_shift($rows); 

        foreach ($rows as &$row) {
            $row = str_replace('</tr>', '', $row);
        }
    }
    

    echo "<!-- Found " . count($rows) . " rows -->";
    
    foreach ($rows as $row) {
     
        $cellPatterns = [
            '/<td[^>]*><p[^>]*>(.*?)<\/p><\/td>/si',  
            '/<td[^>]*>(.*?)<\/td>/si',               
            '/<th[^>]*>(.*?)<\/th>/si'               
        ];
        
        $cells = [];
        foreach ($cellPatterns as $pattern) {
            preg_match_all($pattern, $row, $matches);
            if (!empty($matches[1]) && count($matches[1]) >= 3) {
                $cells = $matches[1];
                break;
            }
        }
        
      
        if (empty($cells)) {
            $tdParts = explode('<td', $row);
            array_shift($tdParts); 
            
            foreach ($tdParts as $tdPart) {
                $endPos = strpos($tdPart, '</td>');
                if ($endPos !== false) {
                    $cellContent = substr($tdPart, strpos($tdPart, '>') + 1, $endPos - strpos($tdPart, '>') - 1);
                    $cellContent = strip_tags($cellContent);
                    $cells[] = trim($cellContent);
                }
            }
        }
        
       
        if (count($cells) >= 4) {
            $visitors[] = [
                'ip' => $cells[0] ?? 'Unknown',
                'browser' => $cells[1] ?? 'Unknown',
                'os' => $cells[2] ?? 'Unknown',
                'country' => $cells[3] ?? 'Unknown',
                'date' => $cells[4] ?? date('Y-m-d H:i:s')
            ];
        }
    }
    
  
    echo "<!-- Parsed " . count($visitors) . " visitors -->";
    
    return array_reverse($visitors);
}

